//@version=6
indicator("H1 Institutional Order Block & Swing Trader [Dineshfx] (Improved)", overlay=true, max_boxes_count=100, max_labels_count=200, max_lines_count=200)

// ==============================================================================
// 1. INPUT CONFIGURATION
// ==============================================================================
grp_smc = "=== Market Structure & Order Block Detection ==="
pivotSpan            = input.int(8, "Swing Pivot Span (Bars)", minval=2, maxval=20, tooltip="Bars left & right to confirm institutional swing pivot.", group=grp_smc)
minDisp              = input.float(8.0, "Base Min Displacement ($ on Gold)", minval=0.5, step=0.5, tooltip="Displacement required after pivot on H1. Automatically scales for M15/M30 if enabled below.", group=grp_smc)
autoScaleDisp        = input.bool(true, "Auto-scale Min Displacement by Timeframe", tooltip="Automatically scales displacement: M15 ($3.00), M30 ($5.00), H1 ($8.00), H4 ($15.00). Enables clear box formation across M15, M30, and H1.", group=grp_smc)
requireBOS           = input.bool(false, "Require Break of Structure (BOS)", tooltip="When enabled, requires price to break previous major swing level before confirming zone. Leave false for standard Order Block formation.", group=grp_smc)
useLastOpposing      = input.bool(true, "Use Last Opposing Candle (True SMC)", tooltip="Defines OB as the last up-candle before drop, or last down-candle before rally.", group=grp_smc)
slBuffer             = input.float(2.0, "Stop Loss Buffer ($)", minval=0.5, step=0.5, tooltip="Buffer placed beyond swing wick for institutional invalidation.", group=grp_smc)

grp_trend = "=== Multi-Timeframe Trend Filter ==="
useDailyTrend        = input.bool(false, "Filter by Daily 50 EMA Trend (false = Show Both Buy & Sell OBs)", group=grp_trend)
useCompletedDaily    = input.bool(true, "Use Last Completed Daily Bar (No Repaint)", tooltip="Freezes Daily EMA using yesterday's close. Prevents intraday flickering.", group=grp_trend)
dailyEmaPeriod       = input.int(50, "Daily EMA Period", minval=10, maxval=200, group=grp_trend)

grp_targets = "=== Multi-Tier Targets (R:R) ==="
tp1_RR               = input.float(1.5, "TP 1 Target (R:R) [Quick Scale]", minval=0.5, maxval=5.0, step=0.1, group=grp_targets)
tp2_RR               = input.float(2.5, "TP 2 Target (R:R) [Swing Target]", minval=1.0, maxval=8.0, step=0.1, group=grp_targets)
tp3_RR               = input.float(4.0, "TP 3 Target (R:R) [Macro Runner]", minval=1.5, maxval=10.0, step=0.5, group=grp_targets)
showTPLines          = input.bool(true, "Draw TP Target Lines & Tags", group=grp_targets)
showBOSLines         = input.bool(true, "Draw BOS Break Lines & Badges", group=grp_targets)

grp_lifecycle = "=== Zone Management & Cleanup ==="
enableGarbageCleanup = input.bool(true, "Enable Garbage Collection (Auto-delete Oldest Zones)", tooltip="Uncheck if you want to keep all historical zones visible (up to TradingView's platform drawing limits).", group=grp_lifecycle)
maxActiveZones       = input.int(10, "Max Active Zones Limit", minval=2, maxval=50, tooltip="Zone threshold for garbage collection when enabled.", group=grp_lifecycle)
fadeRetestedZones    = input.bool(true, "Fade Zones on Retest (Visual Distinction)", group=grp_lifecycle)
showConfirmationMark = input.bool(true, "Mark Confirmation Bar (No Delayed Repainting)", tooltip="Draws confirmation boundary so delay between pivot and confirmation is visible.", group=grp_lifecycle)
showHUD              = input.bool(true, "Show Info Dashboard (Top Right)", group=grp_lifecycle)

grp_visual = "=== Color & Visual Styling ==="
colorBullishActive   = input.color(#059669, "Bullish OB Border (Active)", group=grp_visual)
colorBullishFill     = input.color(color.new(#10b981, 80), "Bullish OB Fill (Active)", group=grp_visual)
colorBearishActive   = input.color(#eab308, "Bearish OB Border (Active)", group=grp_visual)
colorBearishFill     = input.color(color.new(#facc15, 80), "Bearish OB Fill (Active)", group=grp_visual)
colorRetestedFill    = input.color(color.new(#64748b, 88), "Retested Zone Fill (Faded)", group=grp_visual)
colorInvalidFill     = input.color(color.new(#ef4444, 92), "Invalidated Zone Fill", group=grp_visual)
colorTP1             = input.color(#4ade80, "TP 1 Line (+1.5R)", group=grp_visual)
colorTP2             = input.color(#22c55e, "TP 2 Line (+2.5R)", group=grp_visual)
colorTP3             = input.color(#15803d, "TP 3 Line (+4.0R)", group=grp_visual)

// ==============================================================================
// 2. TIMEFRAME-ADAPTIVE DISPLACEMENT CALCULATION
// ==============================================================================
float effectiveMinDisp = minDisp
if autoScaleDisp
    if timeframe.isminutes
        if timeframe.multiplier <= 5
            effectiveMinDisp := 1.5
        else if timeframe.multiplier <= 15
            effectiveMinDisp := 3.0
        else if timeframe.multiplier <= 30
            effectiveMinDisp := 5.0
        else if timeframe.multiplier <= 60
            effectiveMinDisp := minDisp
        else
            effectiveMinDisp := 15.0
    else if timeframe.isdaily
        effectiveMinDisp := 25.0

// ==============================================================================
// 3. STABLE DAILY TREND FILTER (Point 5)
// ==============================================================================
dailyCloseSeries = useCompletedDaily ? close[1] : close
dailyEmaRaw      = ta.ema(dailyCloseSeries, dailyEmaPeriod)
dailyEma         = request.security(syminfo.tickerid, "D", dailyEmaRaw, lookahead=barmerge.lookahead_off)

plot(useDailyTrend ? dailyEma : na, "Daily 50 EMA", color=color.new(color.orange, 25), linewidth=2)

trendUp   = not useDailyTrend or (close > dailyEma)
trendDown = not useDailyTrend or (close < dailyEma)

// ==============================================================================
// 4. USER DEFINED TYPE & STORAGE (Point 6 - Dynamic Object Management)
// ==============================================================================
type OBZone
    box     boxId
    line    tp1Line
    line    tp2Line
    line    tp3Line
    label   infoLabel
    label   tp1Label
    label   tp2Label
    label   tp3Label
    line    bosLine
    label   bosLabel
    line    confirmLine
    bool    isBullish
    float   top
    float   bottom
    float   slPrice
    float   entryPrice
    float   tp1Price
    float   tp2Price
    float   tp3Price
    int     startBar
    int     confirmBar
    bool    retested
    bool    invalidated

var OBZone[] activeZones = array.new<OBZone>()

// Garbage collection function to remove oldest zones when limit is exceeded
cleanOldestZone() =>
    if enableGarbageCleanup and array.size(activeZones) > maxActiveZones
        OBZone oldest = array.shift(activeZones)
        if not na(oldest.boxId)
            box.delete(oldest.boxId)
        if not na(oldest.tp1Line)
            line.delete(oldest.tp1Line)
        if not na(oldest.tp2Line)
            line.delete(oldest.tp2Line)
        if not na(oldest.tp3Line)
            line.delete(oldest.tp3Line)
        if not na(oldest.infoLabel)
            label.delete(oldest.infoLabel)
        if not na(oldest.tp1Label)
            label.delete(oldest.tp1Label)
        if not na(oldest.tp2Label)
            label.delete(oldest.tp2Label)
        if not na(oldest.tp3Label)
            label.delete(oldest.tp3Label)
        if not na(oldest.bosLine)
            line.delete(oldest.bosLine)
        if not na(oldest.bosLabel)
            label.delete(oldest.bosLabel)
        if not na(oldest.confirmLine)
            line.delete(oldest.confirmLine)

// ==============================================================================
// 5. STRUCTURE & SWING DETECTION (Points 1, 2 & 3)
// ==============================================================================
pHigh = ta.pivothigh(high, pivotSpan, pivotSpan)
pLow  = ta.pivotlow(low, pivotSpan, pivotSpan)

var float lastMajorSwingHigh = na
var float lastMajorSwingLow  = na
var int   lastSwingHighBar   = na
var int   lastSwingLowBar    = na

if not na(pHigh)
    lastMajorSwingHigh := pHigh
    lastSwingHighBar   := bar_index[pivotSpan]

if not na(pLow)
    lastMajorSwingLow  := pLow
    lastSwingLowBar    := bar_index[pivotSpan]

var bool alertBullishFormed    = false
var bool alertBearishFormed    = false
var bool alertZoneRetested     = false
var bool alertZoneInvalidated  = false
alertBullishFormed    := false
alertBearishFormed    := false
alertZoneRetested     := false
alertZoneInvalidated  := false

// ------------------------------------------------------------------------------
// BEARISH ORDER BLOCK EVALUATION
// ------------------------------------------------------------------------------
if not na(pHigh) and trendDown
    int pivotBar = bar_index[pivotSpan]
    float swingPrice = pHigh

    // Point 3: Measure true displacement from pivot candle to the lowest low formed during confirmation leg
    float impulseLow = low[0]
    int   impulseLowOffset = 0
    for i = 0 to pivotSpan - 1
        if low[i] < impulseLow
            impulseLow := low[i]
            impulseLowOffset := i

    float displacement = swingPrice - impulseLow
    bool displacementOk = displacement >= effectiveMinDisp

    // Point 2: Check Break of Structure (BOS)
    bool bosOk = not requireBOS or (not na(lastMajorSwingLow) and impulseLow < lastMajorSwingLow)

    if displacementOk and bosOk
        // Point 2: Identify true Order Block (last bullish candle before the impulse drop)
        int obOffset = pivotSpan
        if useLastOpposing
            for k = pivotSpan to math.min(pivotSpan + 5, 50)
                if close[k] > open[k]
                    obOffset := k
                    break

        int obBar = bar_index[obOffset]
        float obTop    = high[obOffset]
        float obBottom = math.min(open[obOffset], close[obOffset])

        float entryPrice = obBottom
        float slPrice    = math.max(swingPrice, obTop) + slBuffer
        float riskDist   = slPrice - entryPrice

        if riskDist > 0
            float tp1Price = entryPrice - (riskDist * tp1_RR)
            float tp2Price = entryPrice - (riskDist * tp2_RR)
            float tp3Price = entryPrice - (riskDist * tp3_RR)

            int forwardBar = bar_index + 25

            box obBox = box.new(obBar, obTop, forwardBar, obBottom, border_color=colorBearishActive, border_width=2, bgcolor=colorBearishFill)

            line confLine = na
            if showConfirmationMark
                confLine := line.new(bar_index, obTop, bar_index, obBottom, color=color.new(colorBearishActive, 30), width=1, style=line.style_dotted)

            string tfName = timeframe.isminutes ? str.format("M{0}", timeframe.multiplier) : (timeframe.isdaily ? "D1" : timeframe.period)
            string lblText = str.format("{0} SELL OB (Active)\nEntry: {1,number,#.##} - {2,number,#.##}\nSL: {3,number,#.##} (+${4,number,#.##} buf)\nTP1: {5,number,#.##} (1:{6,number,#.#}R)\nTP2: {7,number,#.##} (1:{8,number,#.#}R)\nTP3: {9,number,#.##} (1:{10,number,#.#}R)", tfName, obBottom, obTop, slPrice, slBuffer, tp1Price, tp1_RR, tp2Price, tp2_RR, tp3Price, tp3_RR)
            label infoLbl = label.new(bar_index, obTop, lblText, color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

            line l1 = na, line l2 = na, line l3 = na
            label t1 = na, label t2 = na, label t3 = na
            if showTPLines
                l1 := line.new(bar_index, tp1Price, forwardBar, tp1Price, color=colorTP1, width=1, style=line.style_dashed)
                t1 := label.new(forwardBar, tp1Price, str.format("TP1: {0,number,#.##} (1:{1,number,#.#}R)", tp1Price, tp1_RR), color=color.new(#16a34a, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)
                l2 := line.new(bar_index, tp2Price, forwardBar, tp2Price, color=colorTP2, width=1, style=line.style_dashed)
                t2 := label.new(forwardBar, tp2Price, str.format("TP2: {0,number,#.##} (1:{1,number,#.#}R)", tp2Price, tp2_RR), color=color.new(#15803d, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)
                l3 := line.new(bar_index, tp3Price, forwardBar, tp3Price, color=colorTP3, width=2, style=line.style_dashed)
                t3 := label.new(forwardBar, tp3Price, str.format("TP3: {0,number,#.##} (1:{1,number,#.#}R)", tp3Price, tp3_RR), color=color.new(#14532d, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)

            line bosL = na
            label bosB = na
            if showBOSLines and not na(lastMajorSwingLow) and impulseLow < lastMajorSwingLow
                bosL := line.new(lastSwingLowBar, lastMajorSwingLow, bar_index - impulseLowOffset, lastMajorSwingLow, color=color.new(color.white, 30), width=1, style=line.style_dashed)
                bosB := label.new(bar_index - impulseLowOffset, lastMajorSwingLow, "BOS", color=color.blue, textcolor=color.white, style=label.style_label_center, size=size.tiny)

            OBZone newZone = OBZone.new(obBox, l1, l2, l3, infoLbl, t1, t2, t3, bosL, bosB, confLine, false, obTop, obBottom, slPrice, entryPrice, tp1Price, tp2Price, tp3Price, obBar, bar_index, false, false)
            array.push(activeZones, newZone)
            cleanOldestZone()

            alertBearishFormed := true

// ------------------------------------------------------------------------------
// BULLISH ORDER BLOCK EVALUATION
// ------------------------------------------------------------------------------
if not na(pLow) and trendUp
    int pivotBar = bar_index[pivotSpan]
    float swingPrice = pLow

    // Point 3: Measure true displacement
    float impulseHigh = high[0]
    int   impulseHighOffset = 0
    for i = 0 to pivotSpan - 1
        if high[i] > impulseHigh
            impulseHigh := high[i]
            impulseHighOffset := i

    float displacement = impulseHigh - swingPrice
    bool displacementOk = displacement >= effectiveMinDisp

    // Point 2: Check Break of Structure (BOS)
    bool bosOk = not requireBOS or (not na(lastMajorSwingHigh) and impulseHigh > lastMajorSwingHigh)

    if displacementOk and bosOk
        // Point 2: Identify true Order Block (last bearish candle before the impulse surge)
        int obOffset = pivotSpan
        if useLastOpposing
            for k = pivotSpan to math.min(pivotSpan + 5, 50)
                if close[k] < open[k]
                    obOffset := k
                    break

        int obBar = bar_index[obOffset]
        float obTop    = math.max(open[obOffset], close[obOffset])
        float obBottom = low[obOffset]

        float entryPrice = obTop
        float slPrice    = math.min(swingPrice, obBottom) - slBuffer
        float riskDist   = entryPrice - slPrice

        if riskDist > 0
            float tp1Price = entryPrice + (riskDist * tp1_RR)
            float tp2Price = entryPrice + (riskDist * tp2_RR)
            float tp3Price = entryPrice + (riskDist * tp3_RR)

            int forwardBar = bar_index + 25

            box obBox = box.new(obBar, obTop, forwardBar, obBottom, border_color=colorBullishActive, border_width=2, bgcolor=colorBullishFill)

            line confLine = na
            if showConfirmationMark
                confLine := line.new(bar_index, obTop, bar_index, obBottom, color=color.new(colorBullishActive, 30), width=1, style=line.style_dotted)

            string tfName = timeframe.isminutes ? str.format("M{0}", timeframe.multiplier) : (timeframe.isdaily ? "D1" : timeframe.period)
            string lblText = str.format("{0} BUY OB (Active)\nEntry: {1,number,#.##} - {2,number,#.##}\nSL: {3,number,#.##} (-${4,number,#.##} buf)\nTP1: {5,number,#.##} (1:{6,number,#.#}R)\nTP2: {7,number,#.##} (1:{8,number,#.#}R)\nTP3: {9,number,#.##} (1:{10,number,#.#}R)", tfName, obBottom, obTop, slPrice, slBuffer, tp1Price, tp1_RR, tp2Price, tp2_RR, tp3Price, tp3_RR)
            label infoLbl = label.new(bar_index, obBottom, lblText, color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

            line l1 = na, line l2 = na, line l3 = na
            label t1 = na, label t2 = na, label t3 = na
            if showTPLines
                l1 := line.new(bar_index, tp1Price, forwardBar, tp1Price, color=colorTP1, width=1, style=line.style_dashed)
                t1 := label.new(forwardBar, tp1Price, str.format("TP1: {0,number,#.##} (1:{1,number,#.#}R)", tp1Price, tp1_RR), color=color.new(#16a34a, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)
                l2 := line.new(bar_index, tp2Price, forwardBar, tp2Price, color=colorTP2, width=1, style=line.style_dashed)
                t2 := label.new(forwardBar, tp2Price, str.format("TP2: {0,number,#.##} (1:{1,number,#.#}R)", tp2Price, tp2_RR), color=color.new(#15803d, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)
                l3 := line.new(bar_index, tp3Price, forwardBar, tp3Price, color=colorTP3, width=2, style=line.style_dashed)
                t3 := label.new(forwardBar, tp3Price, str.format("TP3: {0,number,#.##} (1:{1,number,#.#}R)", tp3Price, tp3_RR), color=color.new(#14532d, 0), textcolor=color.white, style=label.style_label_left, size=size.tiny)

            line bosL = na
            label bosB = na
            if showBOSLines and not na(lastMajorSwingHigh) and impulseHigh > lastMajorSwingHigh
                bosL := line.new(lastSwingHighBar, lastMajorSwingHigh, bar_index - impulseHighOffset, lastMajorSwingHigh, color=color.new(color.white, 30), width=1, style=line.style_dashed)
                bosB := label.new(bar_index - impulseHighOffset, lastMajorSwingHigh, "BOS", color=color.blue, textcolor=color.white, style=label.style_label_center, size=size.tiny)

            OBZone newZone = OBZone.new(obBox, l1, l2, l3, infoLbl, t1, t2, t3, bosL, bosB, confLine, true, obTop, obBottom, slPrice, entryPrice, tp1Price, tp2Price, tp3Price, obBar, bar_index, false, false)
            array.push(activeZones, newZone)
            cleanOldestZone()

            alertBullishFormed := true

// ==============================================================================
// 6. LIVE ZONE LIFECYCLE MANAGEMENT (Point 6)
// ==============================================================================
if array.size(activeZones) > 0
    for idx = 0 to array.size(activeZones) - 1
        OBZone z = array.get(activeZones, idx)

        if not z.invalidated
            // Check for Retest
            if not z.retested
                bool touched = false
                if z.isBullish and low <= z.top and high >= z.bottom
                    touched := true
                else if not z.isBullish and high >= z.bottom and low <= z.top
                    touched := true

                if touched
                    z.retested := true
                    alertZoneRetested := true
                    if fadeRetestedZones and not na(z.boxId)
                        box.set_bgcolor(z.boxId, colorRetestedFill)
                        box.set_border_style(z.boxId, line.style_dotted)

            // Check for Invalidation
            bool broken = false
            if z.isBullish and close < z.slPrice
                broken := true
            else if not z.isBullish and close > z.slPrice
                broken := true

            if broken
                z.invalidated := true
                alertZoneInvalidated := true
                if not na(z.boxId)
                    box.set_bgcolor(z.boxId, colorInvalidFill)
                    box.set_border_style(z.boxId, line.style_dashed)
                if not na(z.infoLabel)
                    label.set_text(z.infoLabel, z.isBullish ? "BUY OB (Invalidated ❌)" : "SELL OB (Invalidated ❌)")
                
                // Erase TP1, TP2, TP3 lines and target tags for invalidated OBs
                if not na(z.tp1Line)
                    line.delete(z.tp1Line)
                    z.tp1Line := na
                if not na(z.tp2Line)
                    line.delete(z.tp2Line)
                    z.tp2Line := na
                if not na(z.tp3Line)
                    line.delete(z.tp3Line)
                    z.tp3Line := na
                if not na(z.tp1Label)
                    label.delete(z.tp1Label)
                    z.tp1Label := na
                if not na(z.tp2Label)
                    label.delete(z.tp2Label)
                    z.tp2Label := na
                if not na(z.tp3Label)
                    label.delete(z.tp3Label)
                    z.tp3Label := na

// ==============================================================================
// 7. DASHBOARD HUD (Top Right Info Table)
// ==============================================================================
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(#0f172a, 15), border_color=#334155, border_width=1)
if barstate.islast and showHUD
    string trendText = trendUp ? "Uptrend 🟢" : "Downtrend 🔴"
    color trendColor = trendUp ? #22c55e : #ef4444
    int activeCount = 0
    if array.size(activeZones) > 0
        for i = 0 to array.size(activeZones) - 1
            OBZone z = array.get(activeZones, i)
            if not z.invalidated
                activeCount += 1

    string currentTF = timeframe.isminutes ? str.format("M{0}", timeframe.multiplier) : (timeframe.isdaily ? "D1" : timeframe.period)

    table.cell(hud, 0, 0, "Institutional OB [Improved]", bgcolor=#1e293b, text_color=color.yellow, text_size=size.small)
    table.cell(hud, 1, 0, str.format("TF: {0}", currentTF), bgcolor=#1e293b, text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 1, str.format("Daily 50 EMA: {0,number,#.##}", dailyEma), text_color=trendColor, text_size=size.tiny)
    table.cell(hud, 1, 1, trendText, text_color=trendColor, text_size=size.tiny)

    table.cell(hud, 0, 2, "Trend Filter:", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 2, useDailyTrend ? "ON" : "OFF", text_color=useDailyTrend ? color.green : color.gray, text_size=size.tiny)

    table.cell(hud, 0, 3, "Min Displacement:", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 3, str.format("${0,number,#.##}", effectiveMinDisp), text_color=color.yellow, text_size=size.tiny)

    table.cell(hud, 0, 4, "Active Zones:", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 4, enableGarbageCleanup ? str.format("{0} / {1}", activeCount, maxActiveZones) : str.format("{0} (All kept)", activeCount), text_color=color.white, text_size=size.tiny)

// ==============================================================================
// 8. COMPREHENSIVE ACTIONABLE ALERTS
// ==============================================================================
alertcondition(alertBullishFormed, "New Bullish Order Block Formed", "New Bullish Order Block formed with Displacement!")
alertcondition(alertBearishFormed, "New Bearish Order Block Formed", "New Bearish Order Block formed with Displacement!")
alertcondition(alertZoneRetested, "Price Retesting OB Zone", "Price has entered an active Order Block zone!")
alertcondition(alertZoneInvalidated, "OB Zone Invalidated", "An active Order Block was violated and invalidated!")
