//@version=6
indicator("H1 Institutional Order Block & Swing Trader [Dineshfx]", overlay=true, max_boxes_count=100, max_labels_count=100, max_lines_count=100)

// --- Inputs ---
grp_swing = "=== Swing & Order Block Detection ==="
pivotSpan = input.int(3, "Swing Pivot Span (Bars)", minval=2, maxval=20, group=grp_swing)
minDisp = input.float(8.0, "Min Displacement ($ on Gold)", group=grp_swing)
targetRR = input.float(4.0, "Take Profit Target (R:R)", minval=1.5, maxval=10.0, step=0.5, group=grp_swing)
useDailyTrend = input.bool(true, "Filter by Daily 50 EMA Trend", group=grp_swing)
slBuffer = input.float(2.0, "Stop Loss Buffer ($)", group=grp_swing)

grp_visual = "=== Visual Styling ==="
showTPLines = input.bool(true, "Draw Take Profit (TP) Lines & Target Tags", group=grp_visual)
colorBearish = input.color(color.new(#facc15, 75), "Bearish Order Block (Yellow Box)", group=grp_visual)
colorBearishBorder = input.color(#eab308, "Bearish Box Border", group=grp_visual)
colorBullish = input.color(color.new(#10b981, 75), "Bullish Order Block (Green Box)", group=grp_visual)
colorBullishBorder = input.color(#059669, "Bullish Box Border", group=grp_visual)
colorTPLine = input.color(color.new(#22c55e, 0), "Take Profit Line Color", group=grp_visual)

// --- Daily 50 EMA Trend ---
dailyEma = request.security(syminfo.tickerid, "D", ta.ema(close, 50))
plot(useDailyTrend ? dailyEma : na, "Daily 50 EMA", color=color.new(color.orange, 30), linewidth=2)

trendUp = not useDailyTrend or (close > dailyEma)
trendDown = not useDailyTrend or (close < dailyEma)

// --- Pivot Points & Range Tracking (Global evaluation on every bar) ---
pHigh = ta.pivothigh(high, pivotSpan, pivotSpan)
pLow = ta.pivotlow(low, pivotSpan, pivotSpan)
recentLow = ta.lowest(low, pivotSpan)
recentHigh = ta.highest(high, pivotSpan)

// --- Detect Bearish Order Block (SELL) ---
if not na(pHigh) and trendDown and ((pHigh - recentLow) >= minDisp)
    boxLeft = bar_index[pivotSpan]
    boxRight = bar_index + 40
    boxTop = pHigh
    boxBottom = math.min(open[pivotSpan], close[pivotSpan])
    slPrice = pHigh + slBuffer
    entryPrice = boxBottom
    riskDist = slPrice - entryPrice
    tpPrice = entryPrice - (riskDist * targetRR)

    box.new(boxLeft, boxTop, boxRight, boxBottom, border_color=colorBearishBorder, border_width=1, bgcolor=colorBearish, extend=extend.none)
    labelText = str.format("H1 SELL OB\nEntry: {0,number,#.##}\nSL: {1,number,#.##} (Risk: ${2,number,#.##})\nTP: {3,number,#.##} (1:{4,number,#.#} R:R)", entryPrice, slPrice, riskDist, tpPrice, targetRR)
    label.new(boxLeft, boxTop, labelText, color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

    if showTPLines
        line.new(boxLeft, tpPrice, boxRight, tpPrice, color=colorTPLine, width=2, style=line.style_dashed)
        label.new(boxRight, tpPrice, str.format("TP: {0,number,#.##} (+1:{1,number,#.#}R)", tpPrice, targetRR), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.tiny)

// --- Detect Bullish Order Block (BUY) ---
if not na(pLow) and trendUp and ((recentHigh - pLow) >= minDisp)
    boxLeft = bar_index[pivotSpan]
    boxRight = bar_index + 40
    boxTop = math.max(open[pivotSpan], close[pivotSpan])
    boxBottom = pLow
    slPrice = pLow - slBuffer
    entryPrice = boxTop
    riskDist = entryPrice - slPrice
    tpPrice = entryPrice + (riskDist * targetRR)

    box.new(boxLeft, boxTop, boxRight, boxBottom, border_color=colorBullishBorder, border_width=1, bgcolor=colorBullish, extend=extend.none)
    labelText = str.format("H1 BUY OB\nEntry: {0,number,#.##}\nSL: {1,number,#.##} (Risk: ${2,number,#.##})\nTP: {3,number,#.##} (1:{4,number,#.#} R:R)", entryPrice, slPrice, riskDist, tpPrice, targetRR)
    label.new(boxLeft, boxBottom, labelText, color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

    if showTPLines
        line.new(boxLeft, tpPrice, boxRight, tpPrice, color=colorTPLine, width=2, style=line.style_dashed)
        label.new(boxRight, tpPrice, str.format("TP: {0,number,#.##} (+1:{1,number,#.#}R)", tpPrice, targetRR), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.tiny)

// --- Visual Alerts ---
alertcondition(not na(pHigh) and trendDown, "New Bearish Order Block Formed", "New Bearish Order Block Formed on Gold H1!")
alertcondition(not na(pLow) and trendUp, "New Bullish Order Block Formed", "New Bullish Order Block Formed on Gold H1!")
